{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "guitar-gaming-client",
  "version": "0.1.0",
  "identifier": "com.guitar-gaming-client.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "guitar-gaming-client",
        "width": 1200,
        "height": 900,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/sonic-annotator/sonic-annotator-macos",
      "binaries/vamp-plugins/macos/qm-vamp-plugins.cat",
      "binaries/vamp-plugins/macos/qm-vamp-plugins.dylib",
      "binaries/vamp-plugins/macos/qm-vamp-plugins.n3"
    ]
  }
}
